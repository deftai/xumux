 {
  "name": "pipe/1: a channel without the pipe/1 profile is not treated as a pipe",
  "spec": "pipe.md",
  "requires": [
   "pipe"
  ],
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "pipe-echo",
     "reliable": true,
     "ordered": true
    },
    "expect": "none"
   },
   {
    "expectCtrl": {
