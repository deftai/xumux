[
 {
  "name": "pipe/1: bytes and half-close are echoed, then the channel closes with 1000",
  "spec": "pipe.md",
  "requires": [
   "pipe"
  ],
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "pipe-echo",
     "reliable": true,
     "ordered": true,
     "metadata": {
      "profile": "pipe/1"
     }
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 100000
    }
   },
   {
    "send": {
     "channel": 1,
     "type": 2,
     "bytes": 0
    }
   },
   {
    "expectEcho": {
     "channel": 1,
     "bytes": 100000
    }
   },
   {
    "expectPipeEOF": {
     "channel": 1
    }
   },
   {
    "expectCloseChannel": {
     "id": 1,
     "code": 1000
    }
   }
  ]
 },
 {
  "name": "pipe/1: DATA is never fragmented, even with little credit",
  "spec": "pipe.md",
  "requires": [
   "pipe"
  ],
  "steps": [
   {
    "hello": {
     "maxFramePayload": 4096,
     "maxMessageSize": 4096,
     "initialWindow": 4096
    }
   },
   {
    "open": {
     "id": 1,
     "name": "pipe-echo",
     "reliable": true,
     "ordered": true,
     "metadata": {
      "profile": "pipe/1"
     }
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 30000
    }
   },
   {
    "returnCreditInSteps": {
     "channel": 1,
     "step": 1000,
     "until": 30000
    }
   },
   {
    "expectEcho": {
     "channel": 1,
     "bytes": 30000
    }
   }
  ]
 },
 {
  "name": "pipe/1: credit follows writes to the local end",
  "spec": "pipe.md",
  "requires": [
   "pipe"
  ],
  "config": {
   "initialWindow": 65536,
   "maxMessageSize": 65536
  },
  "steps": [
   {
    "hello": {
     "maxFramePayload": 4096,
     "maxMessageSize": 4096,
     "initialWindow": 4096
    }
   },
   {
    "open": {
     "id": 1,
     "name": "pipe-echo",
     "reliable": true,
     "ordered": true,
     "metadata": {
      "profile": "pipe/1"
     }
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 60000
    }
   },
   {
    "expectCreditAtMostEchoed": {
     "channel": 1,
     "quietMs": 500
    }
   },
   {
    "returnCreditInSteps": {
     "channel": 1,
     "step": 4096,
     "until": 60000
    }
   },
   {
    "expectEcho": {
     "channel": 1,
     "bytes": 60000
    }
   },
   {
    "expectCredit": {
     "channel": 1,
     "atLeast": 60000
    }
   }
  ]
 },
