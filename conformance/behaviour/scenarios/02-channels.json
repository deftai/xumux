 {
  "name": "channels: a closed ID can be reused once both CLOSE_CHANNELs are exchanged",
  "spec": "\u00a75.4",
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 500
    }
   },
   {
    "expectEcho": {
     "channel": 1
    }
   },
   {
    "closeChannel": {
     "id": 1
    }
   },
   {
    "open": {
     "id": 1,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 500
    }
   },
   {
    "expectEcho": {
     "channel": 1
    }
   }
  ]
 },
 {
  "name": "channels: the channel limit rejects further opens with 4002 and keeps the connection",
  "spec": "\u00a75.2",
  "config": {
   "maxChannels": 2
  },
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "open": {
     "id": 3,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "open": {
     "id": 5,
     "name": "echo",
     "reliable": true,
     "ordered": true
    },
    "expect": "none"
   },
   {
    "expectCtrl": {
     "type": "CHANNEL_REJECT",
     "json": {
      "id": 5,
      "code": 4002
     }
    }
   },
   {
    "expectAlive": true
   }
  ]
 },
 {
