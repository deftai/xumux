[
 {
  "name": "channels: OPEN_CHANNEL is acknowledged and the channel carries messages",
  "spec": "\u00a75.2",
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 1000
    }
   },
   {
    "expectEcho": {
     "channel": 1
    }
   }
  ]
 },
 {
  "name": "channels: a refused channel gets CHANNEL_REJECT and its ID is free again",
  "spec": "\u00a75.2",
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "refuse",
     "reliable": true,
     "ordered": true
    },
    "expect": "none"
   },
   {
    "expectCtrl": {
     "type": "CHANNEL_REJECT",
     "json": {
      "id": 1,
      "code": 4010
     }
    }
   },
   {
    "open": {
     "id": 1,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "send": {
     "channel": 1,
     "bytes": 10
    }
   },
   {
    "expectEcho": {
     "channel": 1
    }
   }
  ]
 },
 {
  "name": "channels: an even (server-side) ID from the client closes with 1002",
  "spec": "\u00a75.1",
  "steps": [
   {
    "hello": {}
   },
   {
    "openRaw": {
     "id": 2,
     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "expectClose": {
     "code": 1002
    }
   }
  ]
 },
 {
