 {
  "name": "flow: a receiver returns credit, so a sender can send past the initial window",
  "spec": "\u00a76",
  "config": {
   "initialWindow": 65536,
   "maxMessageSize": 65536
  },
  "steps": [
   {
    "hello": {}
   },
