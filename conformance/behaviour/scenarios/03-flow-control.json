     "name": "echo",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "sendEach": {
     "channel": 1,
     "bytes": 4096,
     "count": 4
    }
   },
   {
    "expectReceived": {
     "channel": 1,
     "bytes": 4096,
     "quietMs": 300
    }
   },
   {
    "grant": {
