  "spec": "\u00a76",
  "config": {
   "initialWindow": 65536,
   "maxMessageSize": 65536
  },
  "steps": [
   {
    "hello": {}
   },
   {
    "open": {
     "id": 1,
     "name": "hold",
     "reliable": true,
     "ordered": true
    }
   },
   {
    "send": {
